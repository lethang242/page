<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ByTony Logo</title>
    <!-- Nhúng Font Montserrat (Thay thế Futura) -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@800&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: Arial, sans-serif;
            overflow: hidden;
        }

        /* Khung chứa Logo */
        .logo-container {
            display: inline-flex;
            align-items: flex-end;
            position: relative;
            user-select: none;
        }

        /* Cụm chữ "By" */
        .brand-by {
            font-family: 'Montserrat', sans-serif;
            font-size: 150px;
            font-weight: 800;
            color: #000000;
            letter-spacing: -6px;
            line-height: 0.8;
        }

        /* Cụm chữ "Tony" */
        .brand-tony {
            font-family: 'Montserrat', sans-serif;
            font-size: 150px;
            font-weight: 800;
            color: #000000;
            letter-spacing: -5px;
            line-height: 0.8;
            position: relative;
        }

        /* Dòng phụ: "Experience From Tony" */
        .sub-text {
            position: absolute;
            top: -14px; /* Đặt mép dưới chạm thẳng thanh gạch ngang chữ T */
            left: 106px; /* Căn lùi vào vừa đúng điểm bắt đầu của chữ 'o' */
            right: 0; /* Kéo dài vừa khít đuôi chữ 'y' */
            font-family: 'Times New Roman', Times, serif;
            font-size: 19.5px;
            font-weight: normal;
            color: #222222;
            white-space: nowrap;
            text-align: justify; /* Căn đều 2 đầu để vừa khít chiều rộng của "ony" */
            text-align-last: justify;
        }
    </style>
</head>
<body>

    <div class="logo-container">
        <span class="brand-by">By</span>
        <div class="brand-tony">
            <div class="sub-text">Experience From Tony</div>
            Tony
        </div>
    </div>

</body>
</html>
